# Public URL of the app (used in magic-link emails)
APP_URL=http://localhost:5173
PORT=3000
# Long random string: used by better-auth and to encrypt AI API keys in the DB
# generate with: openssl rand -base64 32
APP_SECRET=change-me
DATABASE_PATH=./data/app.db
UPLOAD_DIR=./data/uploads

# Comma separated. These users are admin on sign-in.
ADMIN_EMAILS=you@windesheim.nl
# Allowed sign-up domains
ALLOWED_EMAIL_DOMAINS=windesheim.nl,student.windesheim.nl

# Resend (if empty, magic links are printed to the server console)
RESEND_API_KEY=
EMAIL_FROM="Windesheim Readers <noreply@example.com>"

# Optional fallback AI keys (admin settings page takes precedence)
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
