{
  "name": "windesheim-readers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"bun --watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production bun server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun server/db/migrate.ts",
